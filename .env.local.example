# Local Development Environment Variables
# Copy this to .env for local development

# Database - Use local PostgreSQL or Railway development database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/freeaicode

# Application
APP_URL=http://localhost:3000
NODE_ENV=development
LOG_LEVEL=debug

# Admin Authentication - Change these!
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# API Keys - Get these from respective providers
# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Google AI Studio: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=

# Kilo Gateway (if available)
KILO_API_KEY=

# Optional - for manual cron triggers
CRON_SECRET=local-dev-secret

# Optional - for benchmark uploads
BENCHMARK_IMPORT_TOKEN=local-dev-token
