# Production Environment Variables for Railway
# These should be set in Railway dashboard for both web and worker services

# Database - Railway will provide this automatically
DATABASE_URL=${{Postgres.DATABASE_URL}}

# Application - Update with your Railway domain
APP_URL=https://your-app.up.railway.app
NODE_ENV=production
LOG_LEVEL=info

# Admin Authentication - CHANGE THESE!
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-secure-password

# API Keys - Add your keys from respective providers
# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Google AI Studio: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=

# Optional - for manual cron triggers
CRON_SECRET=

# Optional - for benchmark uploads
BENCHMARK_IMPORT_TOKEN=
