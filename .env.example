# Database
DATABASE_URL=postgresql://user:password@host:5432/freeaicode

# Application
APP_URL=https://freeaicode.up.railway.app
NODE_ENV=production
LOG_LEVEL=info

# Admin Authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-secure-password

# API Keys for Connectors
OPENROUTER_API_KEY=sk-or-v1-...
GEMINI_API_KEY=...
KILO_API_KEY=...

# Optional
CRON_SECRET=random-secret-for-manual-cron-triggers
BENCHMARK_IMPORT_TOKEN=token-for-benchmark-uploads
